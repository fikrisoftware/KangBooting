<Window
    x:Class="KangBooting.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KangBooting.App">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="KangBooting" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Bikin USB bootable dari ISO Windows" Opacity="0.7" />
            </StackPanel>

            <!-- ISO source -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="1. Pilih ISO" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="IsoPathTextBox" Width="380" IsReadOnly="True" PlaceholderText="Belum ada ISO dipilih..." />
                        <Button x:Name="PickIsoButton" Content="Pilih ISO..." Click="PickIsoButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Target drive -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="2. Pilih Drive USB" FontWeight="SemiBold" />
                    <ComboBox x:Name="DriveComboBox"
                              Width="480"
                              PlaceholderText="Pilih drive USB"
                              ItemsSource="{x:Bind ViewModel.AvailableDrives}"
                              SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Text="⚠ Semua data di drive ini akan terhapus permanen saat Flash." Opacity="0.7" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Boot mode -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="3. Mode Boot" FontWeight="SemiBold" />
                    <RadioButton x:Name="UefiNtfsRadio" Content="UEFI:NTFS — untuk PC/laptop modern (UEFI)" GroupName="BootMode" Checked="BootModeRadio_Checked" />
                    <RadioButton x:Name="LegacySplitRadio" Content="Legacy+Split FAT32 — untuk PC lawas (BIOS)" GroupName="BootMode" Checked="BootModeRadio_Checked" />
                </StackPanel>
            </Border>

            <!-- Progress -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="4. Proses" FontWeight="SemiBold" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ProcessStepViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{x:Bind Icon, Mode=OneWay}" FontFamily="Consolas" Width="32" />
                                    <TextBlock Text="{x:Bind Label}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="4">
                        <ProgressBar x:Name="FlashProgressBar" Minimum="0" Maximum="100"
                                     Value="{x:Bind ViewModel.CurrentProgress.PercentComplete, Mode=OneWay}" />
                        <TextBlock x:Name="ProgressLabelTextBlock" Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.LastUpdateLabel, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Name="ElapsedTextBlock" Text="{x:Bind ViewModel.ElapsedLabel, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.EtaLabel, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="FlashButton" Content="Flash" Click="FlashButton_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="CancelButton" Content="Batal" Click="CancelButton_Click" Visibility="Collapsed" />
                <Button x:Name="RetryButton" Content="Coba Lagi" Click="RetryButton_Click" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Window>
